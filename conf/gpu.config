/*
 * Perfil GPU (Boltz-1).
 *
 * Requisitos:
 *   - GPU NVIDIA visible en el daemon de Docker
 *   - NVIDIA Container Toolkit instalado en el host
 *   - Imagen gemamx-gpu:1.0.0 disponible (ver docs/PROPUESTAS_PLATAFORMA.md)
 *
 * Uso:
 *   nextflow run . -profile docker,gpu --structures_mode boltz
 *
 * En este equipo (solo Intel UHD) el perfil está configurado pero no es
 * ejecutable; ver README § Limitaciones conocidas.
 */
process {
    withName: 'PREDICT_STRUCTURE' {
        accelerator      = 1
        containerOptions = '--gpus all'
        maxForks         = 1
        cpus             = 4
        memory           = '16 GB'
        time             = '8h'
    }
}
