/*
 * Perfil GPU (Boltz-1) — ejecución local con NVIDIA Container Toolkit.
 *
 * Uso:
 *   nextflow run . -profile docker,gpu --structures_mode boltz
 *
 * Requisitos:
 *   - GPU NVIDIA visible en el daemon de Docker (>= 16 GB de VRAM)
 *   - NVIDIA Container Toolkit instalado en el host
 *   - imagen params.image_gpu con `boltz` en el PATH
 *     (containers/gpu/Dockerfile, ver docs/BOLTZ_HPC.md)
 *
 * En este equipo (sin GPU NVIDIA) el perfil está configurado pero no es
 * ejecutable; el módulo BOLTZ_WT/BOLTZ_MUT solo se activa al editar main.nf
 * (ver docs/BOLTZ_HPC.md § Activación).
 *
 * Mantener en sincronía con el bloque `profiles { gpu { ... } }` de
 * nextflow.config.
 */
process {
    withName: 'BOLTZ_WT|BOLTZ_MUT' {
        accelerator      = 1
        containerOptions = '--gpus all'
        maxForks         = 1
        cpus             = 8
        memory           = '32 GB'
        time             = '8h'
    }
}
