/*
 * Perfil local sin Docker.
 *
 * Ejecuta los scripts CLI de bin/ directamente (requiere las dependencias
 * instaladas en el host: python 3.12, vina, obabel, rdkit, meeko, biopython).
 * Pensado solo para depurar; no es el modo de ejecución soportado.
 *
 * Uso:
 *   nextflow run . -profile local
 */
docker {
    enabled = false
}
