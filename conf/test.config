/*
 * Perfil de pruebas rápidas.
 *
 * Uso preferido (equivale a este archivo):
 *   nextflow run . -profile docker,test
 *
 * Uso alternativo:
 *   nextflow run . -profile docker -c conf/test.config
 *
 * Mantener en sincronía con el bloque `profiles { test { ... } }` de nextflow.config.
 */
params {
    max_variants    = 3
    mutations_json  = "${projectDir}/tests/reference/mutations_snapshot.json"
    structures_mode = 'precomputed'
    structures_dir  = "${projectDir}/tests/reference/structures"
    outdir          = 'results/test'
}
