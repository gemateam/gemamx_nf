/*
 * ============================================================================
 * gemamx_nf — GEMA MX · Pipeline V1 (TCGA-BRCA)
 * Nextflow DSL2 · Docker · MLflow
 *
 * Flujo: ingesta de variantes → FASTA WT/MUT → estructuras 3D →
 *        docking (AutoDock Vina) → métricas y JSON de contrato.
 *
 * Reglas del proyecto:
 *   - Autocontenido: sin rutas ni includes hacia Gemacont/ o GEMXMXv1/.
 *   - Dependencias de runtime: imágenes Docker por nombre y tag fijo + MLflow.
 *   - Nunca `latest`: los tags se validan en nextflow_schema.json.
 *   - workDir en el filesystem Linux (no en /mnt/d).
 * ============================================================================
 */

params {

    // ---------------------------------------------------------------- estudio
    study_id            = 'brca_tcga'
    genes               = 'PIK3CA,TP53,ERBB2,BRCA1,BRCA2,CDH1,GATA3,MAP3K1,KMT2C,PTEN,RB1,ARID1A,SF3B1,AKT1,CBFB'
    // Snapshot opcional de mutaciones crudas; si se informa, INGEST no consulta cBioPortal.
    mutations_json      = null
    max_variants        = 20

    // ------------------------------------------------------------ estructuras
    // precomputed: usa estructuras ya existentes en structures_dir
    // esmfold:     predice WT/MUT con la API pública de ESMFold (sin GPU)
    // boltz:       predice WT/MUT con Boltz-1 (requiere perfil gpu)
    structures_mode     = 'precomputed'
    structures_dir      = null
    // Tamaño del fragmento de dominio (± residuos) para proteínas largas.
    domain_window       = 180

    // ---------------------------------------------------------------- docking
    drug_catalog        = 'assets/drug_catalog.csv'
    exhaustiveness      = 8
    num_modes           = 5
    box_size            = 25
    box_center_mode     = 'mutation'   // mutation | binding_site | centroid
    vina_seed           = 42
    vina_timeout_sec    = 900

    // ----------------------------------------------------------------- mlflow
    mlflow_tracking_uri = 'http://host.docker.internal:5000'
    mlflow_experiment   = 'GEMAMX-V1-NF'

    // ---------------------------------------------------------------- salidas
    // Ver docs/ALMACENAMIENTO.md: tres capas (work/, archivo por corrida,
    // contrato vigente) y ninguna base de datos.
    outdir              = 'results'
    work_dir            = '~/gemamx-work'
    // Copia inmutable de la corrida en <outdir>/runs/<runName>/.
    // El contrato vigente <outdir>/data/ se promueve de forma atómica al final.
    publish_run_archive = true

    // --------------------------------------------------------------- imágenes
    // Tags fijos verificados en el entorno de la plataforma.
    image_cpu           = 'gemamx-cpu:1.0.0'
    image_docking       = 'gemamx-nf-docking:1.0.0'
    image_gpu           = 'gemamx-gpu:1.0.0'
    image_mlflow        = 'gemamx-cpu:1.0.0'
}

// ---------------------------------------------------------------------------
// workDir en filesystem Linux (rendimiento: /mnt/d es 9p y muy lento)
// ---------------------------------------------------------------------------
workDir = params.work_dir.replace('~', System.getProperty('user.home'))

// ---------------------------------------------------------------------------
// Ejecutor local por defecto (los perfiles activan Docker)
// ---------------------------------------------------------------------------
docker {
    enabled     = false
    // Las rutas montadas por Nextflow son válidas para el daemon (WSL2).
    remove      = true
    // No se usa userEmulation: las imágenes de la plataforma asumen root.
}

process {
    cpus          = 1
    memory        = '2 GB'
    time          = '2h'
    errorStrategy = 'terminate'
    maxRetries    = 0

    shell = ['/bin/bash', '-euo', 'pipefail']

    // Los scripts CLI se resuelven desde bin/ (Nextflow lo añade al PATH).
    stageInMode = 'copy'
}

// ---------------------------------------------------------------------------
// Perfiles
// ---------------------------------------------------------------------------
profiles {

    docker {
        docker.enabled = true
    }

    // Red compartida con el stack de la plataforma:
    // permite resolver el servidor MLflow por su nombre de servicio (mlflow:5000).
    'platform-net' {
        docker.enabled     = true
        docker.runOptions  = '--network gemacont_default'
        params.mlflow_tracking_uri = 'http://mlflow:5000'
    }

    // Red del docker-compose propio del proyecto (gemamx_net).
    // Usar cuando el stack se levanta con docker compose up en este repo.
    'gemamx-net' {
        docker.enabled     = true
        docker.runOptions  = '--network gemamx_net'
        params.mlflow_tracking_uri = 'http://gemamx_mlflow:5000'
    }

    // Perfil de pruebas rápidas: 1 variante (PIK3CA_H1047R), estructuras precomputadas.
    // outdir intencionalente igual al de producción para que la webapp vea los resultados;
    // el aislamiento de la ejecución lo provee work_dir y el run archive en runs/<name>/.
    test {
        params.max_variants      = 1
        params.mutations_json    = "${projectDir}/tests/reference/mutations_snapshot.json"
        params.structures_mode   = 'precomputed'
        params.structures_dir    = "${projectDir}/tests/reference/structures"
        params.exhaustiveness    = 1
        params.vina_timeout_sec  = 1800
        params.outdir            = 'results'
    }

    // Perfil GPU (Boltz-1). Requiere NVIDIA Container Toolkit en el daemon.
    gpu {
        docker.enabled = true
        process {
            withName: 'PREDICT_STRUCTURE' {
                accelerator      = 1
                containerOptions = '--gpus all'
                maxForks         = 1
                cpus             = 4
                memory           = '16 GB'
                time             = '8h'
            }
        }
    }

    // Sin contenedores (útil para depurar los scripts CLI en local).
    local {
        docker.enabled = false
    }
}

// ---------------------------------------------------------------------------
// Recursos por proceso
// ---------------------------------------------------------------------------
process {
    withName: 'INGEST'                                         { cpus = 2; memory = '3 GB'; time = '2h' }
    withName: 'FETCH_FASTA_WT|FETCH_FASTA_MUT'                { cpus = 1; memory = '2 GB'; time = '1h' }
    withName: 'PREDICT_STRUCTURE_WT|PREDICT_STRUCTURE_MUT'    { cpus = 2; memory = '4 GB'; time = '4h'; maxForks = 2 }
    withName: 'ALIGN_WT_MUT'                                   { cpus = 1; memory = '2 GB'; time = '1h' }
    withName: 'PREP_LIGAND'                                    { cpus = 1; memory = '2 GB'; time = '1h' }
    withName: 'PREP_RECEPTOR'                                  { cpus = 1; memory = '2 GB'; time = '1h' }
    withName: 'DOCK_CENTER'                                    { cpus = 1; memory = '1 GB'; time = '30m' }
    withName: 'RUN_VINA'                                       { cpus = 1; memory = '1 GB'; time = '30m'; maxForks = 8 }
    withName: 'BUILD_JSONS'                                    { cpus = 1; memory = '2 GB'; time = '1h' }
    withName: 'PUBLISH'                                        { cpus = 1; memory = '1 GB'; time = '30m' }
    withName: 'LOG_MLFLOW'                                     { cpus = 1; memory = '2 GB'; time = '1h' }
}

// ---------------------------------------------------------------------------
// Informe de ejecución
// Los reportes se guardan bajo <outdir>/pipeline_info/ al finalizar el pipeline.
// Como Nextflow los genera después de terminar todos los procesos, no pueden
// pasarse al proceso LOG_MLFLOW. El script bin/upload_nf_reports.py (invocado
// automáticamente por run_pipeline.sh) los sube al run padre en MLflow cuando
// el pipeline completa con éxito.
// ---------------------------------------------------------------------------
report {
    enabled   = true
    file      = "${params.outdir}/pipeline_info/report.html"
    overwrite = true
}

timeline {
    enabled   = true
    file      = "${params.outdir}/pipeline_info/timeline.html"
    overwrite = true
}

trace {
    enabled   = true
    file      = "${params.outdir}/pipeline_info/trace.tsv"
    overwrite = true
}

dag {
    enabled   = true
    file      = "${params.outdir}/pipeline_info/dag.html"
    overwrite = true
}

manifest {
    name            = 'gemamx-nf'
    description     = 'GEMA MX · pipeline V1 (TCGA-BRCA) — variantes, estructuras y docking'
    mainScript      = 'main.nf'
    nextflowVersion = '>=24.04.0'
}

// ---------------------------------------------------------------------------
// Validación de parámetros
// ---------------------------------------------------------------------------
// `-params-file` y CLI sobrescriben estos valores. La validación estricta de
// tipos/enums vive en nextflow_schema.json (nf-schema o `nextflow schema`).
