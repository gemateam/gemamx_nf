/*
 * ============================================================================
 * gemamx_nf — GEMA MX · Pipeline V1 (TCGA-BRCA)
 * Nextflow DSL2 · Docker · MLflow
 *
 * Flujo: ingesta de variantes → FASTA WT/MUT → estructuras 3D →
 *        docking (AutoDock Vina) → métricas y JSON de contrato.
 *
 * Reglas del proyecto:
 *   - Autocontenido: sin rutas ni includes hacia otros proyectos.
 *   - Dependencias de runtime: imágenes Docker por nombre y tag fijo + MLflow.
 *   - Nunca `latest`: los tags se validan en nextflow_schema.json.
 *   - workDir en el filesystem Linux (no en /mnt/d).
 * ============================================================================
 */

params {

    // ---------------------------------------------------------------- estudio
    study_id            = 'brca_tcga'
    genes               = 'PIK3CA,TP53,ERBB2,BRCA1,BRCA2,CDH1,GATA3,MAP3K1,KMT2C,PTEN,RB1,ARID1A,SF3B1,AKT1,CBFB'
    // Snapshot opcional de mutaciones crudas; si se informa, INGEST no consulta cBioPortal.
    mutations_json      = null
    max_variants        = 20

    // ---------------------------------------------------- clínica opcional (V1)
    // Con clinical_ingest = true, INGEST añade RACE/ETHNICITY/AGE por muestra y
    // los agregados variante × etnia/raza. RACE y ETHNICITY son datos
    // autorreportados por el paciente en cBioPortal: no son ancestría genética.
    clinical_ingest     = false
    // Snapshot local de clinical data (lista de registros de la API). Si se
    // indica, no se consulta la red y clinical_ingest queda implícito.
    clinical_json       = null
    clinical_attributes = 'RACE,ETHNICITY,AGE'
    // Celdas de los agregados por debajo de este umbral se marcan en
    // `small_cells` (no se eliminan).
    clinical_small_cell = 5

    // ----------------------------------------------------------- FASTA precomputados
    // Si se define, FETCH_FASTA_WT y FETCH_FASTA_MUT usan los archivos locales
    // en lugar de consultar UniProt. El directorio debe contener:
    //   <GENE>_WT.fasta  y  <GENE>_<PC>.fasta
    fasta_dir           = null

    // ------------------------------------------------- V2: fuentes crudas Romero
    // Rutas a los suplementarios XLSX de Romero-Córdoba 2021. Solo se usan
    // cuando se corre main_v2.nf con el perfil 'romero-v2'.
    romero_maf          = null   // MOESM8: MAF completo (hoja: HM maf)
    romero_drivers      = null   // MOESM9: mutaciones driver curadas
    romero_clinical     = null   // MOESM4: metadatos clínicos (hoja: Features)
    // Resultados precomputados M3/M4 (solo para main_v2.nf)
    structural_metrics_precomp  = null
    vina_affinities             = null
    docking_complex_dir         = null
    docking_results_dir         = null

    // ------------------------------------------------------------ estructuras
    // precomputed: usa estructuras ya existentes en structures_dir
    // esmfold:     predice WT/MUT con la API pública de ESMFold (sin GPU)
    // boltz:       predice WT/MUT con Boltz-1 (requiere GPU; ver docs/BOLTZ_HPC.md)
    structures_mode     = 'precomputed'
    structures_dir      = null
    // Tamaño del fragmento de dominio (± residuos) para proteínas largas.
    domain_window       = 180
    // Boltz-1 (solo GPU). El MSA automático usa el servidor de ColabFold
    // (requiere salida a internet); en nodos aislados, desactivarlo y pasar el
    // MSA en el YAML.
    boltz_seed          = 42
    boltz_use_msa_server = true

    // ---------------------------------------------------------------- docking
    drug_catalog        = 'assets/drug_catalog.csv'
    exhaustiveness      = 8
    num_modes           = 5
    box_size            = 25
    box_center_mode     = 'mutation'   // mutation | binding_site | centroid
    // V2.1 — sitios de unión por diana y emparejamiento fármaco-diana.
    // Ambos son opcionales: con null el comportamiento es el de V1/V2.
    binding_sites       = null         // CSV gene,site_name,residues,... (assets/binding_sites.csv)
    binding_site_name   = 'ATP_pocket'
    site_on_missing     = 'fail'       // fail | centroid (si el fragmento no cubre el bolsillo)
    target_drug_map     = null         // CSV gene,drug,role (assets/target_drug_map.csv)
    vina_seed           = 42
    vina_timeout_sec    = 900
    max_parallel_vina   = 4

    // ----------------------------------------------------------------- mlflow
    mlflow_tracking_uri = 'http://host.docker.internal:5000'
    mlflow_experiment   = 'GEMAMX-V1-NF'
    // Subida automática de los reportes HTML de Nextflow al run padre.
    // workflow.onComplete lanza bin/nf_reports_hook.sh al terminar la corrida:
    //   mlflow_host_uri       -> subida desde el host (si tiene el cliente mlflow)
    //   mlflow_docker_uri     -> subida dentro del contenedor CPU (fallback)
    //   mlflow_docker_network -> red de docker-compose con el servidor MLflow
    // Por defecto, el stack de docker-compose de este repo (servicio gemamx_mlflow).
    mlflow_host_uri       = 'http://localhost:5000'
    mlflow_docker_uri     = 'http://gemamx_mlflow:5000'
    mlflow_docker_network = 'gemamx_net'

    // ---------------------------------------------------------------- salidas
    // Ver docs/ALMACENAMIENTO.md: tres capas (work/, archivo por corrida,
    // contrato vigente) y ninguna base de datos.
    outdir              = 'results'
    work_dir            = '~/gemamx-work'
    // Copia inmutable de la corrida en <outdir>/runs/<runName>/.
    // El contrato vigente <outdir>/data/ se promueve de forma atómica al final.
    publish_run_archive = true

    // Tras promover data/, el reemplazo de directorio deja el bind mount de la
    // webapp apuntando al árbol anterior: hay que reiniciar el contenedor para
    // que nginx resuelva el nuevo. Los perfiles de prueba lo desactivan.
    webapp_restart      = true
    webapp_container    = 'gemamx_webapp'

    // --------------------------------------------------------------- imágenes
    // Tags fijos verificados en el entorno de la plataforma.
    image_cpu           = 'gemamx-cpu:1.0.0'
    image_docking       = 'gemamx-nf-docking:1.0.0'
    image_gpu           = 'gemamx-gpu:1.0.0'
    image_mlflow        = 'gemamx-cpu:1.0.0'
}

// ---------------------------------------------------------------------------
// workDir en filesystem Linux (rendimiento: /mnt/d es 9p y muy lento)
// ---------------------------------------------------------------------------
workDir = params.work_dir.replace('~', System.getProperty('user.home'))

// ---------------------------------------------------------------------------
// Ejecutor local por defecto (los perfiles activan Docker)
// ---------------------------------------------------------------------------
docker {
    enabled     = false
    // Las rutas montadas por Nextflow son válidas para el daemon (WSL2).
    remove      = true
    // No se usa userEmulation: las imágenes de la plataforma asumen root.
}

process {
    cpus          = 1
    memory        = '2 GB'
    time          = '2h'
    errorStrategy = 'terminate'
    maxRetries    = 0

    shell = ['/bin/bash', '-euo', 'pipefail']

    // Los scripts CLI se resuelven desde bin/ (Nextflow lo añade al PATH).
    stageInMode = 'copy'
}

// ---------------------------------------------------------------------------
// Perfiles
// ---------------------------------------------------------------------------
profiles {

    docker {
        docker.enabled    = true
        // Red del stack de este repo (`docker compose up`): permite resolver
        // gemamx_mlflow:5000 desde LOG_MLFLOW y desde la subida de reportes.
        docker.runOptions = '--network gemamx_net'
    }

    // Red del docker-compose propio del proyecto (gemamx_net).
    // Usar cuando el stack se levanta con docker compose up en este repo.
    'gemamx-net' {
        docker.enabled     = true
        docker.runOptions  = '--network gemamx_net'
        params.mlflow_tracking_uri   = 'http://gemamx_mlflow:5000'
        params.mlflow_docker_uri     = 'http://gemamx_mlflow:5000'
        params.mlflow_docker_network = 'gemamx_net'
    }

    // Perfil de pruebas rápidas: 1 variante (PIK3CA_H1047R), estructuras precomputadas.
    // outdir intencionalente igual al de producción para que la webapp vea los resultados;
    // el aislamiento de la ejecución lo provee work_dir y el run archive en runs/<name>/.
    test {
        params.max_variants      = 1
        params.mutations_json    = "${projectDir}/tests/reference/mutations_snapshot.json"
        // Clínica autorreportada desde un snapshot local: cubre INGEST +
        // BUILD_JSONS sin red y sin depender de cBioPortal.
        params.clinical_ingest   = true
        params.clinical_json     = "${projectDir}/tests/reference/clinical_snapshot.json"
        params.structures_mode   = 'precomputed'
        params.structures_dir    = "${projectDir}/tests/reference/structures"
        params.exhaustiveness    = 1
        params.vina_timeout_sec  = 1800
        params.outdir            = 'results'
    }

    // Perfil GPU local (Boltz-1). Requiere NVIDIA Container Toolkit en el daemon.
    // En este equipo no hay GPU NVIDIA: ver docs/BOLTZ_HPC.md.
    gpu {
        docker.enabled = true
        process {
            withName: 'BOLTZ_WT|BOLTZ_MUT' {
                accelerator      = 1
                containerOptions = '--gpus all'
                maxForks         = 1
                cpus             = 8
                memory           = '32 GB'
                time             = '8h'
            }
        }
    }

    // Ejecutor remoto para YUCA (clúster ACARUS, UNISON): AlmaLinux 9.4, Slurm,
    // 6 nodos GPU con AMD EPYC 9224 + 1 AMD Instinct MI210 (64 GB HBM2e) y ROCm
    // 6.2.3. Límites del clúster: 320 cores simultáneos y 168 h por trabajo.
    // AJUSTAR antes de usar: partición real (`sinfo -s`), cuenta/proyecto y ruta
    // del .sif. Ver docs/BOLTZ_HPC.md.
    //
    //   nextflow run . -profile hpc-yuca --structures_mode boltz
    //
    'hpc-yuca' {
        executor      = 'slurm'
        queue         = 'gpu'          // TODO: confirmar con `sinfo -s`
        params.structures_mode = 'boltz'
        params.image_gpu       = 'gemamx-nf-gpu_1.0.0.sif'
        params.mlflow_tracking_uri = 'http://127.0.0.1:5000'
        // El clúster no ejecuta Docker: Apptainer 1.3.6 ya está instalado.
        docker.enabled = false
        apptainer.enabled = true
        apptainer.autoMounts = true
        // MI210 es AMD: Apptainer monta los dispositivos con --rocm (no --nv).
        apptainer.runOptions = '--rocm'
        process {
            withName: 'BOLTZ_WT|BOLTZ_MUT' {
                accelerator = 1
                cpus        = 16
                memory      = '64 GB'
                time        = '8h'
                // Los nodos GPU tienen ~1.1 TB de RAM y 48 cores.
                resourceLimits = [ cpus: 48, memory: '900 GB', time: '168h' ]
                // `--gpus all` es de Docker; en Apptainer lo aporta --rocm.
                containerOptions = ''
            }
        }
    }

    // Sin contenedores (útil para depurar los scripts CLI en local).
    local {
        docker.enabled = false
    }

    // ─────────────────────────────────────────────────────────────────────────
    // Pipeline V2 — cohorte Romero-Córdoba 2021 (FUCAM/HM)
    // 44 variantes somáticas de exoma completo (mujeres mexicanas FUCAM).
    // Estructuras precomputadas con Boltz-1 en Colab GPU.
    // Fuente: doi:10.1038/s41467-021-22478-1
    //
    //   nextflow run main_v2.nf -profile docker,'romero-v2' --run-name romero_v2
    //
    // ─────────────────────────────────────────────────────────────────────────
    'romero-v2' {
        docker.enabled = true
        params {
            // ── estudio ──────────────────────────────────────────────────────
            study_id            = 'romero_fucam_hm'
            genes               = 'PIK3CA,TP53,AKT1,ERBB2,PTEN,GATA3,MAP3K1'
            max_variants        = 49

            // ── archivos crudos XLSX (dentro del proyecto, tests/reference/romero_v2/raw/)
            romero_maf          = "${projectDir}/tests/reference/romero_v2/raw/41467_2021_22478_MOESM8_ESM.xlsx"
            romero_drivers      = "${projectDir}/tests/reference/romero_v2/raw/41467_2021_22478_MOESM9_ESM.xlsx"
            romero_clinical     = "${projectDir}/tests/reference/romero_v2/raw/41467_2021_22478_MOESM4_ESM.xlsx"

            // ── secuencias y estructuras precomputadas Boltz-1 ───────────────
            fasta_dir           = "${projectDir}/tests/reference/romero_v2/fasta"
            structures_mode     = 'precomputed'
            structures_dir      = "${projectDir}/tests/reference/romero_v2/structures"

            // ── docking ──────────────────────────────────────────────────────
            exhaustiveness      = 1
            vina_timeout_sec    = 1800

            // ── MLflow ────────────────────────────────────────────────────────
            mlflow_experiment   = 'GEMAMX-V2-ROMERO'
        }
    }

    // ─────────────────────────────────────────────────────────────────────────
    // Pipeline V2.1 — SOLO para main_v2_1.nf (el orden de -profile importa):
    //
    //   nextflow run main_v2_1.nf -profile docker,romero-v2,v2_1
    //
    // Caja de docking en el bolsillo ATP de cada diana, solo pares fármaco-diana
    // del mapa, exhaustiveness de producción (romero-v2 usa 1).
    // Con site_on_missing='fail' la corrida se detiene si el fragmento
    // estructural no cubre el bolsillo (ver docs/V2_1.md).
    // ─────────────────────────────────────────────────────────────────────────
    'v2_1' {
        params {
            box_center_mode     = 'binding_site'
            binding_sites       = "${projectDir}/assets/binding_sites.csv"
            target_drug_map     = "${projectDir}/assets/target_drug_map.csv"
            site_on_missing     = 'fail'
            exhaustiveness      = 8
            // Con exh=8 un par lento (p. ej. Everolimus) puede pasar de 30 min.
            // El timeout interno de Vina (3.5 h) debe disparar antes que el
            // `time` del proceso (4h) para que el fallo sea diagnosticable.
            vina_timeout_sec    = 12600
            mlflow_experiment   = 'GEMAMX-V2_1-ROMERO'
        }
    }

    // Prueba de humo de main_v2_1.nf (un WT por variante, solo CPU). Va al final
    // de -profile. Mismo aislamiento que `smoke`, pero sin el tope de 2 variantes:
    // 3 incluye PIK3CA_E542K (ventana distinta de H1047R), el caso que V2 no soportaba.
    //
    //   bash tests/run_smoke_v2_1.sh
    //
    'smoke-v2-1' {
        workDir = "${System.getProperty('user.home')}/gemamx-work-smoke-v2-1"
        params {
            max_variants        = 3
            exhaustiveness      = 1
            vina_timeout_sec    = 1800
            outdir              = 'results/smoke_v2_1'
            publish_run_archive = false
            webapp_restart      = false
            site_on_missing     = 'centroid'
            mlflow_experiment   = 'GEMAMX-SMOKE-V2-1'
        }
    }

    // Prueba de humo de main_v2.nf (V2.0, sin cambios): va SIEMPRE al final de
    // -profile. Aísla outdir, work y MLflow para no tocar results/data (contrato
    // vigente) ni el caché de producción.
    //
    //   bash tests/run_smoke_v2.sh
    //
    smoke {
        workDir = "${System.getProperty('user.home')}/gemamx-work-smoke"
        params {
            // 2 = PIK3CA_H1047R + AKT1_E17K: comparten ventana con su WT por gen.
            // Con 3 entra PIK3CA_E542K (fragmento 362-722 vs WT 867-1068) y
            // ALIGN_WT_MUT falla: limitación conocida de main_v2.nf (un WT por gen),
            // que V2.1 resuelve con un WT por variante (main_v2_1.nf).
            max_variants        = 2
            exhaustiveness      = 1
            vina_timeout_sec    = 1800
            outdir              = 'results/smoke'
            publish_run_archive = false
            webapp_restart      = false
            mlflow_experiment   = 'GEMAMX-SMOKE'
        }
    }

    // ─────────────────────────────────────────────────────────────────────────
    // Pipeline V3 — TCGA-BRCA Hispano/Latino (Contrato Medallion GDC)
    // Casos exclusivamente de cáncer de mama con etnicidad hispana/latina.
    //
    //   nextflow run main_v3.nf -profile docker,'v3-tcga-hispanic' --run-name tcga_hispanic_v3
    // ─────────────────────────────────────────────────────────────────────────
    'v3-tcga-hispanic' {
        docker.enabled = true
        params {
            study_id            = 'TCGA-BRCA-HISPANIC'
            disease_type        = 'Breast Invasive Carcinoma'
            cohort_ethnicity    = 'HISPANIC OR LATINO'
            genes               = 'PIK3CA,TP53,AKT1,CDH1,PTEN,ESR1,GATA3,MAP3K1'
            max_variants        = 20
            total_samples       = 39

            // Contrato de datos versionado (productor: etl_tcga).
            // El bundle se valida antes de INGEST y se lee a nivel paciente.
            contract_dir        = "${projectDir}/tests/reference/tcga_hispanic_v3"
            contract_manifest   = "${projectDir}/tests/reference/tcga_hispanic_v3/manifest.json"
            // Solo true para smoke tests con fixtures curados.
            contract_allow_curated = false
            mutations_json      = null
            clinical_json       = null
            clinical_ingest     = true

            // Estructuras y docking
            structures_mode     = 'precomputed'
            structures_dir      = "${projectDir}/tests/reference/structures"
            exhaustiveness      = 1
            vina_timeout_sec    = 1800
            mlflow_experiment   = 'GEMAMX-V3-TCGA-HISPANIC'
        }
    }
}

// ---------------------------------------------------------------------------
// Recursos por proceso
// ---------------------------------------------------------------------------
process {
    withName: 'VALIDATE_CONTRACT'                              { cpus = 1; memory = '1 GB'; time = '15m' }
    withName: 'INGEST'                                         { cpus = 2; memory = '3 GB'; time = '2h' }
    withName: 'FETCH_FASTA_WT|FETCH_FASTA_MUT'                { cpus = 1; memory = '2 GB'; time = '1h' }
    withName: 'PREDICT_STRUCTURE_WT|PREDICT_STRUCTURE_MUT'    { cpus = 2; memory = '4 GB'; time = '4h'; maxForks = 2 }
    withName: 'PREDICT_STRUCTURE_WT_PAIR|PREDICT_STRUCTURE_MUT_PAIR' { cpus = 2; memory = '4 GB'; time = '4h'; maxForks = 2 }
    withName: 'BOLTZ_WT|BOLTZ_MUT'                              { cpus = 8; memory = '32 GB'; time = '8h'; maxForks = 1 }
    withName: 'ALIGN_WT_MUT'                                   { cpus = 1; memory = '2 GB'; time = '1h' }
    withName: 'PREP_LIGAND'                                    { cpus = 1; memory = '2 GB'; time = '1h' }
    withName: 'PREP_RECEPTOR'                                  { cpus = 1; memory = '2 GB'; time = '1h' }
    withName: 'DOCK_CENTER'                                    { cpus = 1; memory = '1 GB'; time = '30m' }
    withName: 'RUN_VINA' {
        cpus = 1
        memory = '3 GB'
        maxForks = params.max_parallel_vina ?: 4
        time = "${params.vina_timeout_sec + 300}s"
    }
    withName: 'BUILD_JSONS'                                    { cpus = 1; memory = '2 GB'; time = '1h' }
    withName: 'PUBLISH'                                        { cpus = 1; memory = '1 GB'; time = '30m' }
    withName: 'LOG_MLFLOW'                                     { cpus = 1; memory = '2 GB'; time = '1h' }
    // V2
    withName: 'INGEST_ROMERO'                                  { cpus = 2; memory = '4 GB'; time = '2h' }
    withName: 'EXTRACT_CLINICAL'                               { cpus = 1; memory = '2 GB'; time = '1h' }
    withName: 'BUILD_CLINICAL_SUMMARY'                         { cpus = 1; memory = '2 GB'; time = '1h' }
    withName: 'ASSEMBLE_V2'                                    { cpus = 1; memory = '4 GB'; time = '2h' }
    withName: 'PUBLISH_V2'                                     { cpus = 1; memory = '1 GB'; time = '30m' }
}

// ---------------------------------------------------------------------------
// Informe de ejecución
// Los reportes se guardan bajo <outdir>/pipeline_info/ al finalizar el pipeline.
// Como Nextflow los genera después de terminar todos los procesos, no pueden
// pasarse al proceso LOG_MLFLOW. El script bin/upload_nf_reports.py (invocado
// automáticamente por run_pipeline.sh) los sube al run padre en MLflow cuando
// el pipeline completa con éxito.
// ---------------------------------------------------------------------------
report {
    enabled   = true
    file      = "${params.outdir}/pipeline_info/report.html"
    overwrite = true
}

timeline {
    enabled   = true
    file      = "${params.outdir}/pipeline_info/timeline.html"
    overwrite = true
}

trace {
    enabled   = true
    file      = "${params.outdir}/pipeline_info/trace.tsv"
    overwrite = true
}

dag {
    enabled   = true
    file      = "${params.outdir}/pipeline_info/dag.html"
    overwrite = true
}

manifest {
    name            = 'gemamx-nf'
    description     = 'GEMA MX · pipeline V1 (TCGA-BRCA) — variantes, estructuras y docking'
    mainScript      = 'main.nf'
    nextflowVersion = '>=24.04.0'
}

// ---------------------------------------------------------------------------
// Validación de parámetros
// ---------------------------------------------------------------------------
// `-params-file` y CLI sobrescriben estos valores. La validación estricta de
// tipos/enums vive en nextflow_schema.json (nf-schema o `nextflow schema`).
